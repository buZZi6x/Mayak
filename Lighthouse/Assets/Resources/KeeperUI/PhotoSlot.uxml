<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <ui:VisualElement name="photo-slot" class="photo-slot" tabindex="0" focusable="true">
    <ui:Image name="photo" class="slot-image" picking-mode="Ignore" />
    <ui:Image name="empty-icon" class="empty-icon" picking-mode="Ignore" />
    <ui:Label name="number" class="slot-number key" picking-mode="Ignore" />
    <ui:VisualElement name="caption" class="slot-caption row" picking-mode="Ignore"><ui:Label name="price" /><ui:Image name="sent" class="sent-icon" /><ui:VisualElement name="pending" class="pending" /></ui:VisualElement>
    <ui:VisualElement class="selection-mark select-tl" picking-mode="Ignore" /><ui:VisualElement class="selection-mark select-br" picking-mode="Ignore" />
  </ui:VisualElement>
</ui:UXML>
